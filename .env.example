# CommitVault backend — copy to `.env` for native development.
# Never commit `.env`. In Docker these values come from the workspace `.env`.

# development | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# PostgreSQL connection string (the dev database from ../docker-compose.yml).
DATABASE_URL=postgres://commitvault:change-me-postgres-password@localhost:5433/commitvault
# Optional: pool size (default 10).
# DATABASE_MAX_CONNECTIONS=10

# At least 64 random characters. Generate with: openssl rand -hex 48
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-48-and-paste-here-0000000000
# true in production (HTTPS); false only for plain-HTTP local development.
COOKIE_SECURE=false
# Idle session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Created once, on first start, when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-use-a-long-passphrase

# Exact frontend origin(s), comma separated. No wildcards.
FRONTEND_ORIGIN=http://localhost:5173
# true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Swagger UI + /api/v1/openapi.json. Default: true in development, false in production.
# ENABLE_API_DOCS=true

# --- Outgoing email (optional) ---------------------------------------------
# With SMTP configured, a browser signing in for the first time (or after 90
# days) must also enter a 6-digit code sent to the account's email, and
# "Forgot password?" works. Leave SMTP_HOST empty to keep password-only
# sign-in (and no password reset by email).
# SMTP_HOST=smtp.example.com
# starttls (default, port 587) | tls (port 465) | none (local relay only)
# SMTP_TLS=starttls
# SMTP_PORT=587
# SMTP_USERNAME=vault@example.com
# SMTP_PASSWORD=change-me-smtp-password
# SMTP_FROM=CommitVault <vault@example.com>

RUST_LOG=commitvault=debug,tower_http=info,sqlx=warn
